<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="MainBackgroundColor1">#1F1F25</Color>
    <Color x:Key="MainBackgroundColor2">#27272D</Color>
    
    <Color x:Key="MainForegroundColor1">#4E505A</Color>
    <Color x:Key="MainForegroundColor2">#8F8E94</Color>
    <Color x:Key="MainForegroundColor3">#C3C3C7</Color>

    <Color x:Key="InputBackgroundColor">#222127</Color>
    
    <Color x:Key="ButtonBackgroundColor1">#485EC8</Color>
    <Color x:Key="ButtonBackgroundColor2">#6377E6</Color>
    <Color x:Key="ButtonBackgroundColor3">#57C2DD</Color>

    <SolidColorBrush x:Key="MainBackgroundBrush1" Color="{StaticResource MainBackgroundColor1}"/>
    <SolidColorBrush x:Key="MainBackgroundBrush2" Color="{StaticResource MainBackgroundColor2}"/>

    <SolidColorBrush x:Key="MainForegroundBrush1" Color="{StaticResource MainForegroundColor1}"/>
    <SolidColorBrush x:Key="MainForegroundBrush2" Color="{StaticResource MainForegroundColor2}"/>
    <SolidColorBrush x:Key="MainForegroundBrush3" Color="{StaticResource MainForegroundColor3}"/>
</ResourceDictionary>